from base_plugin import BasePlugin, HookResult

__id__ = "exteragram_ai"
__name__ = "AI Assistant"
__description__ = "AI assistant for preparing message replies"
__author__ = "kkiyama228"
__version__ = "0.2.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = "integrations"


class AIAssistantPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_hook("TL_updateNewMessage")
        self.logger.info("AI Assistant loaded; incoming-message event hook registered")

    def on_update_hook(self, update_name, account, update):
        if update_name == "TL_updateNewMessage":
            self.logger.info("Incoming message event detected (content not recorded)")
        return HookResult()
