
from typing import Any, List

from base_plugin import BasePlugin, HookResult
from ui.settings import Header, Text, Divider

__id__ = "exteragram_ai"
__name__ = "AI Assistant"
__description__ = "AI assistant for preparing message replies"
__author__ = "kkiyama228"
__version__ = "0.4.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = "integrations"


class AIAssistantPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updates")
        self.logger.info("AI Assistant 0.4.0 loaded; update hooks registered")

    def on_update_hook(self, update_name, account, update):
        if update_name == "TL_updateNewMessage":
            count = self.get_setting("single_update_count", 0)
            self.set_setting("single_update_count", count + 1)
            self.logger.info("Diagnostic: TL_updateNewMessage received")

        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        if container_name == "TL_updates":
            count = self.get_setting("updates_container_count", 0)
            self.set_setting("updates_container_count", count + 1)
            self.logger.info("Diagnostic: TL_updates container received")

        return HookResult()

    def reset_counter(self, view):
        self.set_setting("single_update_count", 0)
        self.set_setting("updates_container_count", 0, reload_settings=True)

    def create_settings(self) -> List[Any]:
        single_count = self.get_setting("single_update_count", 0)
        container_count = self.get_setting("updates_container_count", 0)

        return [
            Header(text="Диагностика получения сообщений"),
            Text(
                text=f"Отдельные события: {single_count}",
                subtext="События TL_updateNewMessage",
                icon="msg_info"
            ),
            Text(
                text=f"Контейнеры обновлений: {container_count}",
                subtext="События TL_updates",
                icon="msg_info"
            ),
            Divider(),
            Text(
                text="Сбросить счётчики",
                subtext="Начать диагностику заново",
                icon="msg_delete",
                red=True,
                on_click=self.reset_counter
            )
        ]
