from typing import Any, List

from base_plugin import BasePlugin, HookResult
from ui.settings import Header, Text, Divider

__id__ = "exteragram_ai"
__name__ = "AI Assistant"
__description__ = "AI Assistant update hook diagnostic"
__author__ = "kkiyama228"
__version__ = "0.6.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = "integrations"


class AIAssistantPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_hook("TL_updateNewMessage")

        count = self.get_setting("load_count", 0)
        self.set_setting("load_count", count + 1)
        self.logger.info("AI Assistant 0.6.0 loaded; TL_updateNewMessage hook registered")

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        calls = self.get_setting("update_hook_calls", 0) + 1
        self.set_setting("update_hook_calls", calls)

        if update_name == "TL_updateNewMessage":
            messages = self.get_setting("new_message_events", 0) + 1
            self.set_setting("new_message_events", messages, reload_settings=True)
            self.logger.info("Received TL_updateNewMessage")

        return HookResult()

    def reset_counter(self, view):
        self.set_setting("update_hook_calls", 0)
        self.set_setting("new_message_events", 0)
        self.set_setting("load_count", 0, reload_settings=True)

    def create_settings(self) -> List[Any]:
        return [
            Header(text="AI Assistant — диагностика"),

            Text(
                text=f"Запусков плагина: {self.get_setting('load_count', 0)}",
                subtext="Плагин успешно загружается",
                icon="msg_info"
            ),

            Text(
                text=f"Вызовов обработчика: {self.get_setting('update_hook_calls', 0)}",
                subtext="События, переданные в on_update_hook",
                icon="msg_info"
            ),

            Text(
                text=f"Новых сообщений: {self.get_setting('new_message_events', 0)}",
                subtext="TL_updateNewMessage",
                icon="msg_info"
            ),

            Divider(),

            Text(
                text="Сбросить счётчики",
                subtext="Обнулить диагностические значения",
                icon="msg_delete",
                red=True,
                on_click=self.reset_counter
            )
        ]
